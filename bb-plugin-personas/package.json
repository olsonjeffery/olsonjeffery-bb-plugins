{
  "name": "bb-plugin-personas",
  "version": "1.14.1",
  "type": "module",
  "engines": {
    "bb": ">=0.39.0",
    "bbPluginSdk": ">=0.6.15"
  },
  "bb": {
    "name": "Personas",
    "description": "Build a reusable fleet of AI personas: each with its own prompt pool, provider, model, and reasoning level, chatting in ordinary BB threads. Attach a Floating Note and the chat always sees its current text. Pick a persona from the New Thread composer's persona button — a persona chip rides with your message and the thread belongs to that persona. Every thread header shows who it is chatting as. Export every persona to a JSON file and import it into another BB instance; the Floating Notes plugin is needed only for note prompts.",
    "branding": {
      "icon": "./assets/icon.svg",
      "experimental_icons": {
        "robot": "./assets/icons/robot.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.75",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.0",
    "hono": "^4.11.9",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "bb plugin build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
