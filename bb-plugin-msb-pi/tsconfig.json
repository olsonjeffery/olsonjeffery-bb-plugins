{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "server.ts",
    "host.ts",
    "app.tsx",
    "contract.ts",
    "host-contract.ts",
    "snapshot.ts",
    "probe.ts",
    "diff.ts",
    "store.ts",
    "cli-msb-pi.ts",
    "lib"
  ]
}
