{
  "name": "bb-plugin-drawio",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "Drawio",
    "description": "Edit diagrams in BB with a self-hosted draw.io: an embedded editor in the app shell that opens and CAS-saves .drawio files in Docs vaults, project worktrees, and host paths — one tab per open diagram, draft autosave so a close never loses work, and client-side export to PNG/JPEG/SVG/PDF/XML.",
    "branding": {
      "icon": "Workflow"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "@radix-ui/react-slot": "^1.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@pierre/diffs": "~1.2.12",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^29.1.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
